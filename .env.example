## Haven Hub 环境配置示例

# API 基础地址（可选，默认为课程接口）
API_BASE_URL=https://live-api.itheima.net/

# 腾讯地图服务 Key（必须，从腾讯位置服务控制台获取）
# 用途类型：WebService API
# 申请地址：https://lbs.qq.com/console/mykey.html
TENCENT_MAP_KEY=your_tencent_map_key_here

# 定位坐标系类型（可选，默认为 auto）
# 支持的值：
#   auto   - 自动判断（虚拟机用 GCJ-02，真机用 WGS84）
#   gcj02  - 强制使用 GCJ-02（火星坐标系，适用于虚拟机和拾取器坐标）
#   wgs84  - 强制使用 WGS84（GPS 原始坐标，适用于真机）
LOCATION_COORDINATE_SYSTEM=auto
