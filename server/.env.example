# 本地开发默认配置，不发送短信；真实短信另见 .env.production.example 和 docs/tencent_sms_setup.md。
NODE_ENV=development
# 信任的代理跳数；本地开发不信任 X-Forwarded-For，避免伪造来源 IP。
TRUST_PROXY=0
# 留空不启用客户端版本门禁；启用前核对 Flutter 与物业网页的实际版本。
# 仅接受正式三段版本，例如 1.0.0；不代表已批准生产支持周期。
CLIENT_MIN_VERSION=
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DATABASE_PATH=data/haven.sqlite
AUTH_MODE=development
# 先停止正常服务再启用；维护进程不打开数据库，不运行后台任务。
MAINTENANCE_MODE=false
# 可选只读监控摘要凭证文件（仓库外绝对路径）；留空关闭机器指标接口。
OPERATIONS_KEYS_FILE=
# 可选脱敏运行日志；填新的专用绝对目录，父目录须存在；留空仅输出标准输出。
# 最多5个1MiB分段（含当前文件），按数量淘汰，不代表生产保存期限。
RUNTIME_LOG_DIRECTORY=
RUNTIME_LOG_MAX_BYTES=1048576
RUNTIME_LOG_MAX_FILES=5

# 物业联系电话，对住户和师傅可见；请使用虚构号码。
PROPERTY_PHONE=020-88888888

# 可选系统推送；服务仍只监听回环地址，详见 docs/system_push_setup.md。
# 浏览器 VAPID 密钥自动保存在当前 SQLite 数据库，勿清库或分享数据库。
WEB_PUSH_SUBJECT=https://localhost
# 华为服务账号 JSON 密钥仅保存在仓库外，不打包到客户端。
HUAWEI_PUSH_PROJECT_ID=
HUAWEI_PUSH_KEY_FILE=
HUAWEI_PUSH_CATEGORY=MARKETING
HUAWEI_PUSH_TEST_MESSAGE=true
