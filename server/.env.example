# 本地学习服务，不能用于公网生产环境；不发送短信。
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DATABASE_PATH=data/haven.sqlite
AUTH_MODE=development

# 物业联系电话，对住户和师傅可见；请使用虚构号码。
PROPERTY_PHONE=020-88888888

# 可选系统推送；服务仍只监听回环地址，详见 docs/system_push_setup.md。
# 浏览器 VAPID 密钥自动保存在当前 SQLite 数据库，勿清库或分享数据库。
WEB_PUSH_SUBJECT=https://localhost
# 华为服务账号 JSON 密钥仅保存在仓库外，不打包到客户端。
HUAWEI_PUSH_PROJECT_ID=
HUAWEI_PUSH_KEY_FILE=
HUAWEI_PUSH_CATEGORY=MARKETING
HUAWEI_PUSH_TEST_MESSAGE=true
