# 生产配置模板；空项必须按真实部署填写，不能直接启动或替代上线验收。
# 腾讯云密钥只放仓库外受限权限文件，不在此填写，也不要打包到 App。
NODE_ENV=production
AUTH_MODE=tencent
# 显式配置反向代理跳数；无代理设0，同机单层反向代理通常设1。
TRUST_PROXY=1
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=
# 同源网页可留空；分离部署填 HTTPS 来源，以逗号分隔，不使用通配符。
CORS_ORIGINS=
# 必须是新的、独立生产数据库绝对路径；禁止复制演示库。
DATABASE_PATH=
PROPERTY_PHONE=
CLIENT_MIN_VERSION=1.0.0
MAINTENANCE_MODE=false
# 可选：仅含监控密钥摘要的仓库外绝对路径，详见 docs/operations_monitoring.md。
OPERATIONS_KEYS_FILE=
# 可选脱敏运行日志：仓库外专用绝对目录，必须与业务库和监控目录分开。
# 启用后写盘失败会使 /ready 返回503；生产保存期限需单独确定。
RUNTIME_LOG_DIRECTORY=
RUNTIME_LOG_MAX_BYTES=1048576
RUNTIME_LOG_MAX_FILES=5

TENCENT_SMS_APP_ID=
TENCENT_SMS_TEMPLATE_ID=
# 审核通过的签名内容，不是签名 ID。
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_REGION=ap-guangzhou
# 按已审核模板明确选 code 或 code,minutes，后者依次传验证码与固定的5分钟。
TENCENT_SMS_TEMPLATE_PARAMS=
TENCENT_SMS_KEY_FILE=
# 滚动窗口，失败/超时也占额度；全局额度须由运营方按预算明确填写。
SMS_PHONE_HOURLY_LIMIT=5
SMS_PHONE_DAILY_LIMIT=10
SMS_GLOBAL_DAILY_LIMIT=

# 推送另按 docs/system_push_setup.md 配置和验收。
WEB_PUSH_SUBJECT=https://localhost
HUAWEI_PUSH_PROJECT_ID=
HUAWEI_PUSH_KEY_FILE=
HUAWEI_PUSH_CATEGORY=MARKETING
HUAWEI_PUSH_TEST_MESSAGE=false
