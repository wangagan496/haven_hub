# 复制为 dart_defines.local.env 后填写真实 Key。
TENCENT_MAP_KEY=
# 可选：高德开放平台 Web 服务 Key；未填写时继续使用腾讯地图。
AMAP_WEB_KEY=
LOCATION_COORDINATE_SYSTEM=auto
# Web 调试时另通过命令行设置为：http://127.0.0.1:3001/tencent-map/
# 高德 Web 调试代理：http://127.0.0.1:3001/amap-map/
# 原生/鸿蒙端不要设置代理地址，默认直连地图服务。
# TENCENT_MAP_API_BASE_URL=
# AMAP_API_BASE_URL=
